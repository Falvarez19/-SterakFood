# ==========================================================================
# CONFIGURACIÓN BASE PARA UN NUEVO RESTAURANTE
# Copiá estas variables al entorno de Render/Railway o a tu archivo .env local.
# ==========================================================================

# Django
SECRET_KEY=cambiar-por-una-clave-segura
DEBUG=False
ALLOWED_HOSTS=midominio.com,www.midominio.com,miapp.onrender.com
CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com,https://miapp.onrender.com

# Base de datos (dejar vacío en local si querés usar SQLite)
DATABASE_URL=

# Marca
RESTAURANT_NAME=Mi Restaurante

# Dashboard
DASHBOARD_PIN=5968

# Mercado Pago
MP_ACCESS_TOKEN=

# Nave, solo si ese restaurante lo usa
NAVE_ACCESS_TOKEN=

# Google Reviews. Si queda vacío, la tarjeta de Google no aparece.
GOOGLE_REVIEW_URL=

# Modal de bienvenida
WELCOME_MODAL_ENABLED=false

# Ticketera local
TICKETERA_BASE_URL=https://midominio.com
IMPRESORA_CAJA=FACTURA_PYTHON
IP_COCINA=192.168.1.250
IP_BARRA=192.168.1.198
ANCHO_TICKET=32
